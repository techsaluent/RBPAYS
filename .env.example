# ---- Server ----
NODE_ENV=development
PORT=8080
# Public URL of this API (used in logs / links)
API_BASE_URL=https://api.rbpays.in

# ---- PostgreSQL (self-hosted on your VPS) ----
# Either provide a full DATABASE_URL, or the discrete PG* values below.
DATABASE_URL=postgres://rbpays:changeme@127.0.0.1:5432/rbpays
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=rbpays
# PGPASSWORD=changeme
# PGDATABASE=rbpays
# Set to "require" if your VPS Postgres enforces SSL
PGSSLMODE=disable
PG_POOL_MAX=10

# ---- Auth / JWT ----
# Generate strong secrets, e.g.  openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ---- CORS ----
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=https://rbpays.in,https://app.rbpays.in

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Providers ----
# Per-module provider selection. Defaults to "sandbox" so the API runs without
# any external credentials. Switch to a real provider once configured below.
#   DMT / BBPS / RECHARGE : sandbox | aggregator
#   PAYOUT / GATEWAY      : sandbox | razorpay
PROVIDER_DMT=sandbox
PROVIDER_BBPS=sandbox
PROVIDER_RECHARGE=sandbox
PROVIDER_PAYOUT=sandbox
PROVIDER_GATEWAY=sandbox
HTTP_TIMEOUT_MS=20000

# Razorpay / RazorpayX (payment gateway + payouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Aggregator switch for DMT / BBPS / Recharge (e.g. Paysprint, EKO)
AGGREGATOR_BASE_URL=
AGGREGATOR_API_KEY=
AGGREGATOR_AUTH_TOKEN=
AGGREGATOR_PARTNER_ID=
AGGREGATOR_WEBHOOK_SECRET=

# ---- Admin seed (npm run seed:admin) ----
ADMIN_NAME=RBPAYS Admin
ADMIN_EMAIL=admin@rbpays.in
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=change-this-strong-password
